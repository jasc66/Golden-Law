# Perfil de contenido: golden-law | demo
NEXT_PUBLIC_SITE_PROFILE=golden-law
# URL pública (sitemap, canonical, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com
# Ocultar las marcas de "contenido pendiente" cuando todo esté confirmado
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
# Idioma de la interfaz: es | en
NEXT_PUBLIC_LOCALE=es
# Destino del formulario (Zapier, Make, n8n, Resend, Formspree…). Obligatorio en producción.
CONTACT_WEBHOOK_URL=
